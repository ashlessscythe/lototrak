generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String?
  role            Role      @default(PENDING)
  resetToken      String?
  resetTokenExpiry DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  locks           Lock[]    @relation("AssignedTo")
  events          Event[]
  departments     UserDepartment[]
}

model Company {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  departments Department[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  isDefault   Boolean      @default(false)

  @@index([isDefault])
}

model Department {
  id          String           @id @default(cuid())
  name        String
  description String?
  company     Company          @relation(fields: [companyId], references: [id])
  companyId   String
  users       UserDepartment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  isDefault   Boolean          @default(false)

  @@unique([name, companyId])
  @@index([isDefault])
}

model UserDepartment {
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String
  assignedAt   DateTime   @default(now())

  @@id([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
}

model Lock {
  id               String    @id @default(cuid())
  name             String
  location         String
  status           Status    @default(AVAILABLE)
  qrCode           String    @unique
  deleted          Boolean   @default(false)  // Added deleted flag
  safetyProcedures Json?    // Made optional with default null
  assignedTo       User?     @relation("AssignedTo", fields: [userId], references: [id])
  userId           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Event {
  id            String    @id @default(cuid())
  type          EventType
  details       String
  location      String    // Location is now required
  safetyChecks  Json?    // Optional safety checks
  lockName      String    // Store lock name directly
  lockStatus    Status    // Store lock status at time of event
  lockId        String    // Keep reference for querying but remove relation
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  createdAt     DateTime  @default(now())
}

enum Role {
  ADMIN
  MANAGER
  SUPERVISOR
  USER
  PENDING
}

enum Status {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum EventType {
  LOCK_ASSIGNED
  LOCK_RELEASED
  STATUS_CHANGED
  MAINTENANCE
  EMERGENCY_OVERRIDE
  SAFETY_CHECK_COMPLETED
}

model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
